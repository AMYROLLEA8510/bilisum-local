{
  "manifest_version": 3,
  "name": "BiliSum",
  "version": "5.2.1",
  "description": "Bilibili course notes, transcription fallback, batch processing and local file export.",
  "key": "",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "webNavigation",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://api.bilibili.com/*",
    "https://*.bilibili.com/*",
    "https://*.hdslb.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/list/*",
        "https://space.bilibili.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "BiliSum"
  }
}
